# Publish only reviewed source, project data, assets and documentation.
# Historical reports and local user material stay local by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/LICENSE.md
!/VERSION
!/build.sh
!/Sources/
/Sources/*
!/Sources/*.swift
!/Tests/
/Tests/*
!/Tests/*.swift
!/Tests/check.sh
!/Config/
/Config/*
!/Config/*.plist
!/Assets/
/Assets/*
!/Assets/*.png
!/Assets/DeadOps.icns
!/Assets/AppIcon/
/Assets/AppIcon/*
!/Assets/AppIcon/DeadOps-Icon.png
!/Assets/Music/
/Assets/Music/*
!/Assets/Music/LESEN.txt
!/DeadOpsReconstruction.xcodeproj/
/DeadOpsReconstruction.xcodeproj/*
!/DeadOpsReconstruction.xcodeproj/project.pbxproj
!/DeadOpsReconstruction.xcodeproj/project.xcworkspace/
/DeadOpsReconstruction.xcodeproj/project.xcworkspace/*
!/DeadOpsReconstruction.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!/DeadOpsReconstruction.xcodeproj/xcshareddata/
/DeadOpsReconstruction.xcodeproj/xcshareddata/*
!/DeadOpsReconstruction.xcodeproj/xcshareddata/xcschemes/
!/DeadOpsReconstruction.xcodeproj/xcshareddata/xcschemes/*.xcscheme
!/docs/
!/docs/**
!/scripts/
/scripts/*
!/scripts/*.py
**/.DS_Store
**/__pycache__/
**/*.pyc
**/xcuserdata/
**/*.xcuserstate
**/.env*
**/*.mobileprovision
**/*.p12
**/*.key
**/*.app/
**/*.zip
